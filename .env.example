# GroqAI Configuration Template

# Server & Network Ports
API_PORT=5001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5001

# PostgreSQL Database (Local user or Docker Compose: postgresql://groqai_user:groqai_password@localhost:5432/groqai)
DATABASE_URL=postgresql://arnavyadav@localhost:5432/groqai

# Optional Background Job Redis
REDIS_URL=

# AI Provider for Natural Language parsing (only converts text to items; never supplies prices!)
AI_PROVIDER=none
AI_API_KEY=

# Platform Integration Modes: mock | manual | partner_feed | authorized_api | permitted_page
BLINKIT_INTEGRATION_MODE=mock
ZEPTO_INTEGRATION_MODE=mock
INSTAMART_INTEGRATION_MODE=mock
BIGBASKET_INTEGRATION_MODE=mock
