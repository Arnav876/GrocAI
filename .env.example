# GroqAI Configuration Template

# Server & Network Ports
API_PORT=5001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5001

# PostgreSQL Database (Local user or Docker Compose: postgresql://groqai_user:groqai_password@localhost:5432/groqai)
DATABASE_URL=postgresql://arnavyadav@localhost:5432/groqai

# Optional Background Job Redis
REDIS_URL=

# AI Provider for Natural Language parsing (only converts text to items; never supplies prices!)
AI_PROVIDER=none
AI_API_KEY=

# Platform Integration Modes: mock | manual | partner_feed | authorized_api | permitted_page | links_only
BLINKIT_INTEGRATION_MODE=mock
ZEPTO_INTEGRATION_MODE=mock
INSTAMART_INTEGRATION_MODE=mock
BIGBASKET_INTEGRATION_MODE=mock

# Live Provider Credentials & Endpoints (Supplied when bilateral partner agreement is executed)
BLINKIT_API_BASE_URL=
BLINKIT_API_KEY=
ZEPTO_API_BASE_URL=
ZEPTO_API_KEY=
INSTAMART_API_BASE_URL=
INSTAMART_API_KEY=
BIGBASKET_API_BASE_URL=
BIGBASKET_API_KEY=

# Freshness, Caching & Timeouts (Milliseconds)
PRICE_CACHE_TTL_MS=3600000             # 1 hour: reuse fresh cache without hitting external provider
PRICE_STALE_TTL_MS=21600000            # 6 hours: threshold after which price is flagged stale
EXTERNAL_REQUEST_TIMEOUT_MS=4000       # 4 seconds: per-request timeout before controlled backoff
MAX_PROVIDER_RETRIES=2                 # Max retry attempts for transient 5xx/network errors
BLOCKED_PLATFORM_COOLDOWN_MS=1800000  # 30 minutes: scheduler backoff after a blocked capture

# Supervised Browser Automation (Playwright)
# Invariants: Heavier sessions only, zero headless hidden scraping, auto-disabled on anti-bot challenge
PLAYWRIGHT_ENABLED=false

# Optional admin API protection. When set, /api/admin/* and fee writes require
# x-admin-key: <value> or Authorization: Bearer <value>. Leave empty in local dev.
ADMIN_API_KEY=
